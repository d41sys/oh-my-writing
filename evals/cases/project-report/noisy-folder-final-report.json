      "pattern": "(?i)\\ball\\b[^.\\n]{0,30}(handover|hand-over|closure)[^.\\n]{0,30}(complete|completed|done|finished)",
      "note": "two handover items are still open; completion is not overstated"
    },
    {
      "type": "regex",
      "pattern": "(?is)decommission[^\\n]{0,300}(no owner|unassigned|not assigned|nobody|no one|no (set |agreed |confirmed )?date|not (yet )?(scheduled|dated|set|planned|assigned|named)|(owner|date)[^.\\n]{0,40}(missing|open|needed|tbd|unknown|not (yet )?(named|assigned|set|agreed|confirmed))|ASK AUTHOR)",
      "note": "the legacy decommission has no owner or date in any document: the report says so (any wording), rather than leaving it out or guessing"
    },
    {
      "type": "not_regex",
      "pattern": "(?i)(decommission\\w*|legacy[^.\\n]{0,40}(systems?|tools?))[^.\\n]{0,80}(owned by|owner is|owner:|assigned to|led by|will be (done|run|led) by)\\s*(Karl|Nadia|Pavel|Ines|Sofia|Osei|Haddad|Novak|Duarte|Marin|Datamove)|\\b(Karl|Nadia|Pavel|Ines|Sofia|Osei|Haddad|Novak|Duarte|Marin|Datamove)\\b[^.\\n]{0,30}\\bwill (own|decommission|lead|run|handle)\\b[^.\\n]{0,60}(decommission|legacy)",
      "note": "no owner may be invented for the decommissioning"
