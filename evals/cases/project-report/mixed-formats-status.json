            "\\boct(ober)? 5\\b",
            "2026-10-05"
          ]
        },
        {
          "id": "launch-previous",
          "any": [
            "\\b14 sep(tember)?\\b",
            "\\bsep(tember)? 14\\b",
            "2026-09-14"
          ]
        },
        {
          "id": "cfo-second-signoff",
          "any": [
            "(?s)(CFO|Tomas|Brandt|second sign-?off).{0,300}150,?000",
            "(?s)150,?000.{0,300}(CFO|Tomas|Brandt|second sign-?off)"
          ]
        },
        {
          "id": "gateway-sandbox-delay",
          "any": [
            "\\b31 jul(y)?\\b",
            "\\bjul(y)? 31\\b",
            "2026-07-31"
          ]
        },
        {
