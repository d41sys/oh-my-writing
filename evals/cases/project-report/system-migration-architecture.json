      ],
      "self_check": true,
      "note": "architecture and data-flow diagrams name only components that exist in the documents (Tracking API, Scan Ingest Worker, RabbitMQ, PostgreSQL, Notification Service ...), invent none, and chart numbers come from metrics.csv",
      "labels_any": [
        {
          "id": "tracking-api",
          "any": [
            "Tracking API"
          ]
        },
        {
          "id": "scan-ingest",
          "any": [
